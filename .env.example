# EmailJS — https://dashboard.emailjs.com
# Copy this file to `.env` and fill in the values. All three are safe to ship
# to the browser: the public key is designed to be public. Never put the
# EmailJS *private* key or any SMTP password here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional — the site's public URL once deployed (e.g. https://your-site.netlify.app).
# Enables canonical / Open Graph image tags and sitemap.xml at build time.
VITE_SITE_URL=
